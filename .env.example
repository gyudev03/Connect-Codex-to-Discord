DISCORD_TOKEN=put-your-discord-bot-token-here

# Optional
COMMAND_PREFIX=!
CODEX_WORKSPACE=D:\Coding\Connect-Codex-to-Discord
CODEX_PROJECTS_ROOT=D:\Coding
CODEX_COMMAND=codex
CODEX_MODEL=
CODEX_ARGS=--full-auto
CODEX_TIMEOUT_SECONDS=1800
MAX_PARALLEL_CODEX_JOBS=1
DISCORD_CODEX_CATEGORY_ID=
DISCORD_CODEX_CATEGORY_NAME=ai
DISCORD_CHANGELOG_FORUM_ID=
DISCORD_CHANGELOG_FORUM_NAME=ai-수정내역
CODEX_GENERAL_CHANNEL_NAMES=ai
CATEGORY_CHAT_ENABLED=true
MENTION_CHAT_ENABLED=true
THREAD_CHAT_ENABLED=true
WAKE_WORDS=코덱스야,코덱스
INSTANT_REPLIES_ENABLED=false
SLOW_NOTICE_ENABLED=true
SLOW_NOTICE_SECONDS=12
GITHUB_REPO_OWNER=
GITHUB_DEFAULT_VISIBILITY=private
GEMINI_REVIEW_ENABLED=true
GEMINI_BOT_USER_IDS=
GEMINI_REVIEW_AUTO_REQUEST=false
GEMINI_REVIEW_EMOJI=🔍
GEMINI_REVIEW_MAX_DIFF_CHARS=12000
GEMINI_REVIEW_WAIT_SECONDS=600
GEMINI_DISCORD_TOKEN=put-your-gemini-discord-bot-token-here
GEMINI_API_KEY=put-your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_REVIEW_MAX_INPUT_CHARS=60000
GEMINI_REVIEW_MAX_OUTPUT_TOKENS=1200
GEMINI_REVIEW_ATTACHMENT_MAX_BYTES=1048576

# Comma-separated Discord channel IDs. Leave empty to allow every channel.
DISCORD_ALLOWED_CHANNEL_IDS=

# Comma-separated Discord role IDs. Leave empty to allow every member.
DISCORD_ALLOWED_ROLE_IDS=
