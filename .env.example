DISCORD_TOKEN=put-your-discord-bot-token-here

# Optional
COMMAND_PREFIX=!
CODEX_WORKSPACE=D:\Coding\Connect-Codex-to-Discord
CODEX_COMMAND=codex
CODEX_MODEL=
CODEX_ARGS=--full-auto
CODEX_TIMEOUT_SECONDS=1800
MAX_PARALLEL_CODEX_JOBS=1
MENTION_CHAT_ENABLED=true
THREAD_CHAT_ENABLED=true

# Comma-separated Discord channel IDs. Leave empty to allow every channel.
DISCORD_ALLOWED_CHANNEL_IDS=

# Comma-separated Discord role IDs. Leave empty to allow every member.
DISCORD_ALLOWED_ROLE_IDS=
